# LM Studio (OpenAI-compatible server)
BRAIN_LLM_URL=http://localhost:1234/v1
BRAIN_LLM_MODEL=ternary-bonsai-2-27b-mlx
BRAIN_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
BRAIN_LLM_CONCURRENCY=2       # parallel requests sent to LM Studio (enable concurrent predictions there)

# Runtime
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000
BRAIN_AUTOSTART=false         # true = start the autonomous loop when the server boots
BRAIN_MAX_CYCLES=200
BRAIN_MAX_TOKENS=0            # 0 = unlimited
BRAIN_MAX_PARALLEL_AGENTS=3   # goals executed concurrently
BRAIN_AGENT_MAX_STEPS=14
BRAIN_REFLECT_EVERY=3
BRAIN_EVOLVE_EVERY=5

# Sandbox (Podman)
BRAIN_PODMAN=podman
BRAIN_PODMAN_CONNECTION=      # optional: podman --connection <name>
BRAIN_SANDBOX_IMAGE=brain-sandbox:latest
BRAIN_SANDBOX_TIMEOUT=120
BRAIN_SANDBOX_MEMORY=1g
BRAIN_SANDBOX_CPUS=2
